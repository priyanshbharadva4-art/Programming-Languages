<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Timetable</title>
<style>
        body {
            font-family: Arial;
            text-align: center;
        }
        table {
            border-collapse: collapse;
            margin: auto;
            width: 90%;
        }
        th, td {
            border: 2px solid black;
            padding: 10px;
        }
        th {
            background-color: #f2f2f2;
        }
        .lunch {
            writing-mode: horizontal-tb;
            font-weight: bold;
        }
    </style>
</head>
<body>

<h1>Class Time Table</h1>

<table>
    <tr>
        <th>Day / Time</th>
        <th>Monday</th>
        <th>Tuesday</th>
        <th>Wednesday</th>
        <th>Thursday</th>
        <th>Friday</th>
        
    </tr>

    <tr>
        <th>9:00 - 10:00</th>
        <td>Maths</td>
        <td>Physics</td>
        <td>English</td>
        <td>Chemistry</td>
        <td>Physical Ed.</td>
    </tr>

    <tr>
        <th>10:00 - 11:00</th>
        <td>Physics</td>
        <td>Maths</td>
        <td>Chemistry</td>
        <td>Maths</td>
        <td>Library</td>
    </tr>

    <tr>
        <th>11:00 - 12:00</th>
        <td>Maths</td>
        <td>Chemistry</td>
        <td>Physics</td>
        <td>Math</td>
        <td>Computer Lab</td>
    </tr>

    <tr>
        <th>12:00 - 1:00</th>
        <td colspan="5" class="lunch">LUNCH</td>
    </tr>

    <tr>
        <th>1:00 - 2:00</th>
        <td>Maths</td>
        <td>Chemistry</td>
        <td>Physics</td>
        <td>English</td>
        <td rowspan = "2">Sports</td>
    </tr>

    <tr>
        <th>2:00 - 3:00</th>
        <td>English</td>
        <td>Maths</td>
        <td>Chemistry</td>
        <td>Physics</td>z
    </tr>

</table>
    
</body>
</html>