#include <iostream>
using namespace std;

// Global Variables
char board[3][3] = {
    {'1','2','3'},
    {'4','5','6'},
    {'7','8','9'}
};

char currentPlayer = 'X';

// Display Board
void displayBoard() {
    cout << "\n";
    for(int i=0; i<3; i++) {
        cout << " ";
        for(int j=0; j<3; j++) {
            cout << board[i][j];
            if(j<2) cout << " | ";
        }
        if(i<2) cout << "\n---|---|---\n";
    }
    cout << "\n";
}

// Make Move
void makeMove() {
    int choice;
    cout << "Player " << currentPlayer << ", enter position (1-9): ";
    cin >> choice;

    int row = (choice - 1) / 3;
    int col = (choice - 1) % 3;

    if(board[row][col] != 'X' && board[row][col] != 'O') {
        board[row][col] = currentPlayer;
        currentPlayer = (currentPlayer == 'X') ? 'O' : 'X';
    } else {
        cout << "Invalid move! Try again.\n";
        makeMove();
    }
}

// Check Win
bool checkWin() {
    for(int i=0; i<3; i++) {
        if(board[i][0] == board[i][1] && board[i][1] == board[i][2])
            return true;

        if(board[0][i] == board[1][i] && board[1][i] == board[2][i])
            return true;
    }

    if(board[0][0] == board[1][1] && board[1][1] == board[2][2])
        return true;

    if(board[0][2] == board[1][1] && board[1][1] == board[2][0])
        return true;

    return false;
}

// Check Draw
bool checkDraw() {
    for(int i=0; i<3; i++) {
        for(int j=0; j<3; j++) {
            if(board[i][j] != 'X' && board[i][j] != 'O')
                return false;
        }
    }
    return true;
}

// Main Function
int main() {
    while(true) {
        displayBoard();
        makeMove();

        if(checkWin()) {
            displayBoard();
            cout << "Player " << (currentPlayer == 'X' ? 'O' : 'X') << " wins!\n";
            break;
        }

        if(checkDraw()) {
            displayBoard();
            cout << "Game is a draw!\n";
            break;
        }
    }

    return 0;
}