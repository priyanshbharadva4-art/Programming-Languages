#include<stdio.h>

int fib(int n)
{
    if(n == 0)
    {
        return 0;
    }

    else if(n == 1)
    {
        return 1;
    }

    else
    {
        return (fib(n-1) + fib(n-2));
    }
}

int main()
{
    int terms;
    printf("Enter the number of terms for the fibonicci series:");
    scanf("%d", &terms);

    if(terms<0)
    {
        printf("Number of terms cannot be negative");
    }

    else
    {
        printf("Fibonacci Series:");
        for(int i=0; i<terms; i++)
        {
            printf("%d \t", fib(i));
        }
        printf("\n");
    }
    
    return 0;
}