#include<stdio.h>
int main()
{
    int num, fact = 1, i = 1;

    printf("Enter a positive number: ");
    scanf("%d", &num);

    if(num < 0)
    {
        printf("Factorial is not defined for negative numbers.");
    }

    else
    {
        while (i <= num)
        {
            fact *= i;
            i++;
        }
        printf("Factorial of %d is: %d", num, fact);
    }
    return 0;
}