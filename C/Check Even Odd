#include<stdio.h>
int main()
{
    int x;

    printf("Enter a number: ");
    scanf("%d", &x);

    if(x % 2 == 0) // Check if the number is even
    {
        printf("%d is an even number.\n", x);
    }
    else // If the number is not even, it must be odd
    {
        printf("%d is an odd number.\n", x);
    }
    return 0;   
}