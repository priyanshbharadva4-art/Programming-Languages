#include<stdio.h>
int main()
{
    int n, pos, val, choice, i, arr[100];

    printf("Enter number of elements:");
    scanf("%d", &n);

    printf("\n Enter %d elements:", n);
    for(i=0; i<n; i++)
    {
        scanf("%d", &arr[i]);
    }

   printf("\n1. Insert element");
   printf("\n2. Delete element");
   printf("\n Enter your choice:");
   scanf("%d", &choice);

   if(choice == 1)
   {
    printf("Enter position to insert:");
    scanf("%d", &pos);
    printf("Enter value to insert:");
    scanf("%d", &val);

    if(pos<1 || pos>n+1)
    {
        printf("Invalid position!");
    }
    
    else 
    {
        for(i=n; i>=pos; i--)
        {
            arr[i] = arr[i-1];
        }
        arr[pos-1] = val;
        n++;

        printf("\n Array after insertion:");
        for(i=0; i<n; i++)
        {
            printf("%d\t", arr[i]);
        }
   }
}

else if(choice == 2)
{
    printf("Enter position to delete:");
    scanf("%d", &pos);

    if(pos<1 || pos>n)
    {
        printf("Invalid position!");
    }
    else 
    {
        for(i=pos-1; i<n-1; i++)
        {
            arr[i] = arr[i+1];
        }
        n--;

        printf("\n Array after deletion:");
        for(i=0; i<n; i++)
        {
            printf("%d\t", arr[i]);
        }
    }
}
else
{
    printf("Invalid choice!");
}
return 0;
}