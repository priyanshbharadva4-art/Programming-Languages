#include <stdio.h>

int calculateSum(int arr[], int size) 
{
    int sum = 0;
    for (int i = 0; i < size; i++) {
        sum += arr[i];
    }
    return sum;
}

int main() {
    int myArray[] = {10, 20, 30, 40, 50};
    int arraySize = sizeof(myArray) / sizeof(myArray[0]);
    int totalSum = calculateSum(myArray, arraySize);

    printf("The sum of elements in the array is: %d\n", totalSum);
    return 0;
}