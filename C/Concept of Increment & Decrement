#include<stdio.h>
int main()
{
    int x, y, inc, dec;

    printf("Enter two numbers: ");
    scanf("%d %d", &x, &y);

    inc = ++x; // Pre-increment: Increment x by 1, then assign to inc
    dec = --y; // Pre-decrement: Decrement y by 1, then assign to dec
    inc = x++; // Post-increment: Assign x to inc, then increment x by 1
    dec = y--; // Post-decrement: Assign y to dec, then decrement y by 1

    printf("After pre-increment, x = %d\n", x);
    printf("After pre-decrement, y = %d\n", y);
    printf("After post-increment, x = %d\n", x);
    printf("After post-decrement, y = %d\n", y);
    return 0;
}