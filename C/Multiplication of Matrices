#include<stdio.h>
#include<stdlib.h>
int main()
{
    int r1, r2, c1, c2, i, j, k;

    printf("Enter number of rows and columns for first matrix:");
    scanf("%d %d", &r1, &c1);
    printf("Enter number of rows and colums for second matrix:");
    scanf("%d %d", &r2, &c2);

    if(c1 != r2)
    {
        printf("Matrix multiplication is not possible.");
        return 1;
    }

    int a[r1][c1], b[r2][c2], res[r1][c2];

    printf("\n Enter elements of the first matrix:");
    for(i=0; i<r1; i++)
    {
        for(j=0; j<c1; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }

    printf("\n Enter elements of second matrix:");
    for(i=0; i<r2; i++)
    {
        for(j=0; j<c2; j++)
        {
            scanf("%d", &b[i][j]);
        }
    }

    for(i=0; i<r1; i++)
    {
        for(j=0; j<c2; j++)
        {
            res[i][j] = 0;
        }
    }

    for(i=0; i<r1; i++)
    {
        for(j=0; j<c2; j++)
        {
            for(k=0; k<c1; k++)
            {
                res[i][j] += a[i][k] * b[k][j];
            }
        }
    }
    printf("\n Resultant matrix:");
    for(i=0; i<r1; i++)
    {
        for(j=0; j<c2; j++)
        {
            printf("%d\t", res[i][j]);
        }
        printf("\n");
    }
    return 0;
}