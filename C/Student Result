#include <stdio.h>
#include <string.h>

struct Student 
{
    int enroll;
    char name[50];
    int marks[3];
    int total;
    char grade;
};

// Function to calculate grade based on total marks
char calculateGrade(int total) 
{
    if (total >= 240) { // Assuming max total marks is 300 (100 per subject)
        return 'A';
    } else if (total >= 210) {
        return 'B';
    } else if (total >= 180) {
        return 'C';
    } else if (total >= 150) {
        return 'D';
    } else {
        return 'F';
    }
}

int main() {
    struct Student students[3]; 
    int i, j;
    int top = 0; 

    for (i = 0; i < 3; i++) {
        printf("\nEnter details for student %d:\n", i + 1);
        printf("Enrolment Number: ");
        scanf("%d", &students[i].enroll);
        printf("Name: ");
        scanf(" %s[^\n]", students[i].name); 
        students[i].total = 0;
        for (j = 0; j < 3; j++) {
            printf("Marks in Subject %d: ", j + 1);
            scanf("%d", &students[i].marks[j]);
            students[i].total += students[i].marks[j];
        }
        students[i].grade = calculateGrade(students[i].total);
    }

    // Display grade cards of all students
    printf("\n--- Grade Cards ---\n");
    for (i = 0; i < 3; i++) {
        printf("\nStudent: %s (Enrolment: %d)\n", students[i].name, students[i].enroll);
        printf("Total Marks: %d\n", students[i].total);
        printf("Grade: %c\n", students[i].grade);
    }

    // Find and display the student with the top rank
    for (i = 1; i < 3; i++) {
        if (students[i].total > students[top].total) {
            top = i;
        }
    }

    printf("\n--- Top Rank Student ---\n");
    printf("Name: %s\n", students[top].name);
    printf("Enrolment Number: %d\n", students[top].enroll);
    printf("Total Marks: %d\n", students[top].total);
    printf("Grade: %c\n", students[top].grade);

    return 0;
}