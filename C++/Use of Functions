#include <iostream>
#include <fstream>
#include <string>

using namespace std;

int main() {
    string filename = "example.txt";
    string data;

    ofstream outFile(filename, ios::out); 
    
    if (outFile.is_open()) {
        outFile << "Line 1: Created using Constructor (Overwritten mode).\n";
        outFile.close();
        cout << "File created via Constructor successfully." << endl;
    }

    ofstream appendFile;
    appendFile.open(filename, ios::app); 
    
    if (appendFile.is_open()) {
        appendFile << "Line 2: Added using Open() function (Append mode).\n";
        appendFile.close();
        cout << "Data appended via Open() successfully." << endl;
    }

    ifstream inFile;
    inFile.open(filename, ios::in);

    cout << "\n--- Current File Content ---" << endl;
    if (inFile.is_open()) {
        while (getline(inFile, data)) {
            cout << data << endl;
        }
        inFile.close();
    }

    return 0;
}