#include<iostream>
using namespace std;

class time {
    public:
    int hours;
    int min;
    time(int h = 0, int m = 0) : hours(h), min(m) {}

    void add(time t1, time t2) {
        min = t1.min + t2.min;
        hours = min/60;
        min %= 60;
        hours += t1.hours + t2.hours;
    }

    void display() {
        cout<<hours<<"hours and"<<min<<" min"<<endl;
    }
};

int main()
{
    time t1(2, 45);
    time t2(1, 30);
    time t3;

    cout<<"Time 1:";
    t1.display();
    cout<<"Time 2:";
    t2.display();

    t3.add(t1, t2);
    cout<<"Time 3:";
    t3.display();

    return 0;
}