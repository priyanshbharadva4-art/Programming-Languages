#include<iostream>
using namespace std;

class triangle {
    public:
    float b, h;

    void area() {
        cout<<"Enter base and height of triangle: "<<endl;
        cin>>b>>h;
        cout<<"Area of triangle is "<<0.5*b*h<<endl;
    }
};

class square {
    public:
    float l;

    void area() {
        cout<<"Enter side of square: "<<endl;
        cin>>l;
        cout<<"Area of square is "<<l*l<<endl;
    }
};

class circle {
    public:
    float r;

    void area() {
        cout<<"Enter radius of circle: "<<endl;
        cin>>r;
        cout<<"Area of circle is "<<3.14*r*r<<endl;
    }
};

int main()
{
    triangle t;
    square s;
    circle c;

    t.area();
    s.area();
    c.area();

    return 0;
}