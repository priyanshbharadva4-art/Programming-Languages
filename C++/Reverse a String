#include<iostream>
#include<string.h>
using namespace std;

void reverse (char* str, int count = -1) {
    int len = strlen(str);
    int n = (count == -1 || count > len)? len : count;

    for(int i=0; i<n/2; i++){
        char temp = str[i];
        str[i] = str[n-i-1];
        str[n-i-1] = temp;
    }
}

int main()
{
    char s1[] = "Hello World";
    char s2[] = "Programming";

    reverse(s1);
    cout<<"Full reverse:"<<s1<<endl;
    reverse(s2, 4);
    cout<<"Partial reverse(first 4):"<<s2<<endl;

    return 0;
}