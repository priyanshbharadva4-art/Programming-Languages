#include <iostream>
#include <iomanip>  
#include <string>
#include <vector>

using namespace std;

struct Item {
    string name;
    int code;
    float cost;
};

int main() {
    int n;
    cout << "Enter number of items: ";
    cin >> n;

    vector<Item> items(n);

    for (int i = 0; i < n; i++) {
        cout << "\nEnter details for Item " << i + 1 << ":" << endl;
        cout << "Name: ";
        cin.ignore(); 
        getline(cin, items[i].name);
        cout << "Code: ";
        cin >> items[i].code;
        cout << "Cost: ";
        cin >> items[i].cost;
    }

    cout << "\n" << left << setw(15) << "NAME" 
         << setw(10) << "CODE" 
         << right << setw(10) << "COST" << endl;
    cout << "-----------------------------------" << endl;

    cout << fixed << setprecision(2);

    for (int i = 0; i < n; i++) {
        cout << left << setw(15) << items[i].name 
             << setw(10) << items[i].code 
             << right << setw(10) << items[i].cost << endl;
    }

    return 0;
}